# Copy to backend/.env on the server. Never commit the completed file.
# Replace the placeholder with a company-approved persistent path.
FOF_DATA_DIR=__DATA_DIR_FORWARD_SLASH__
# Leave blank for SQLite at FOF_DATA_DIR/fof_reports.db. Set a full URL for PostgreSQL.
DATABASE_URL=
CORS_ORIGINS=http://__SERVER_NAME__,https://__SERVER_NAME__
REPORT_GENERATION_WORKERS=2

HERMES_FEISHU_ENABLED=false
HERMES_FEISHU_GATEWAY_URL=
HERMES_FEISHU_METHOD=POST
HERMES_FEISHU_HEADERS_FILE=./config/hermes_feishu_headers.json
HERMES_FEISHU_PAYLOAD_TEMPLATE_FILE=./config/hermes_feishu_payload.json
HERMES_FEISHU_RECIPIENT_ID=
REPORT_PUBLIC_BASE_URL=http://__SERVER_NAME__
HERMES_FEISHU_TIMEOUT_SECONDS=10
HERMES_FEISHU_MAX_ATTEMPTS=3
HERMES_FEISHU_RETRY_BASE_SECONDS=5
