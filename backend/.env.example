# The backend loads backend/.env automatically. This relative SQLite path is
# resolved against backend/ even if uvicorn is launched from another directory.
# Optional: move all mutable files outside the source checkout in production.
# FOF_DATA_DIR=/approved/absolute/data/path
# Leave blank to use SQLite at FOF_DATA_DIR/fof_reports.db.
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
# Base address written into one-time manager questionnaire links.
# Production example: https://fof.example.company
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173

# Number of Word generation jobs processed concurrently by this service instance.
REPORT_GENERATION_WORKERS=2

# Hermes Feishu gateway. Keep disabled until the real internal gateway contract
# and private recipient/authentication values have been supplied.
HERMES_FEISHU_ENABLED=false
HERMES_FEISHU_GATEWAY_URL=
HERMES_FEISHU_METHOD=POST
HERMES_FEISHU_HEADERS_FILE=./config/hermes_feishu_headers.json
HERMES_FEISHU_PAYLOAD_TEMPLATE_FILE=./config/hermes_feishu_payload.json
HERMES_FEISHU_RECIPIENT_ID=
REPORT_PUBLIC_BASE_URL=
HERMES_FEISHU_TIMEOUT_SECONDS=10
HERMES_FEISHU_MAX_ATTEMPTS=3
HERMES_FEISHU_RETRY_BASE_SECONDS=5

# Example for PostgreSQL in a later deployment:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/fof_reports
